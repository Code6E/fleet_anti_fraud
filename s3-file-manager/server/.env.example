# ===== S3 / 兼容存储连接配置 =====
# 端点：AWS S3 留空即可；兼容存储(如 MinIO / 各类对象存储)填完整地址，例如 http://127.0.0.1:9000
S3_ENDPOINT=
# 区域（AWS 填例如 us-east-1；兼容存储按服务商要求填）
S3_REGION=us-east-1
# 桶名
S3_BUCKET=your-bucket-name
# 访问密钥（Access Key / Secret）
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# 兼容存储通常需要 path-style 访问；AWS S3 可留 false
S3_FORCE_PATH_STYLE=true

# ===== 服务配置 =====
PORT=3001

# ===== 可选：访问口令（设置后前端需先登录才能访问）=====
# 不设置则任何人可直接访问（仅建议在可信内网使用）
APP_PASSWORD=

# ===== 多用户 / 机构（设置后启用账号+机构登录，优先级高于 APP_PASSWORD）=====
# JSON 数组，每个用户归属一个登录机构(org)；role 三级（v1.3e）：
#   admin    = 管理员（全局可见 + 运维功能）
#   org      = 分公司账号（可见本分公司 + 所属全部中支机构的查询记录、返回结果与运行概览）
#   sub_org  = 中支机构账号（仅可见本中支数据；须配 parent_org 指向所属分公司 org）
# org 建议直接配机构名（与上传文件名中的分公司名一致，实现数据隔离与文件过滤）；
# 中支提交的查询在汇总上传时自动并入所属分公司文件（文件按分公司命名上传，中银保信 T+1 原路返回）
# 例：USERS=[{"username":"admin","password":"x","org":"总公司","role":"admin"},{"username":"gd","password":"x","org":"广东分公司","role":"org"},{"username":"gzyx","password":"x","org":"广州市越秀支公司","role":"sub_org","parent_org":"广东分公司"}]
USERS=

# 单口令模式下的默认机构
DEFAULT_ORG=DEFAULT

# ===== 船舶查询服务参数（中银保信规范） =====
# 查询服务名与编号（上传文件命名：船舶_000012_YYYYMMDD_分公司.xlsx 及文件内「查询服务编号」列）
SERVICE_NAME=船舶
SERVICE_NO=000012
# 待查询/结果文件在 S3 上的目录前缀（对齐中银保信真实布局）
UPLOAD_S3_PREFIX=upload/
RESULT_S3_PREFIX=download/

# ===== Agent 调度 =====
# T+1 结果轮询时刻（逗号分隔，HH:MM）；机构自动上传时刻在管理界面按机构设置（限 12:00-14:50）
POLL_TIMES=09:00,11:00,14:00

# ===== AI 解读（DeepSeek，可选） =====
# 未配置 key 时自动降级为规则版报告（离线演示可用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 数据源切换（生产 S3 / 本地离线数据库） =====
# 启动时的默认数据源：s3=生产桶（需内网），local=本地S3数据库（离线调试）
# 服务启动后可在网页右上角随时切换，无需重启
DEFAULT_SOURCE=s3
# 本地S3数据库目录（即 fetch_s3_samples.mjs 拉取的离线镜像）
# 留空 = 默认 <工作区>/本地S3数据库；也可填绝对路径，或相对 server 启动目录的路径
LOCAL_DB_PATH=

# 船讯网（安岚科技）账号——报告第一节「船舶档案」数据源（v1.6）
ANLAN_USERNAME=
ANLAN_PASSWORD=
# ANLAN_BASE_URL=https://cic.anlantech.cn
